{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "app": "concurrently \"npm run dev\" \"node server/index.js\" \"wait-on http://localhost:5173 && electron .\"",
    "package": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.bibliotecapastoral.app",
    "productName": "Biblioteca Pastoral",
    "publish": [
      {
        "provider": "github",
        "owner": "tu-usuario",
        "repo": "biblioteca-pastoral"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*"
    ],
    "extraResources": [
      "mock.bblx"
    ]
  },
  "dependencies": {
    "cors": "^2.8.6",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.47.0",
    "marked": "^18.0.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-quill": "^2.0.0",
    "sql.js": "^1.14.2",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^28.3.3",
    "electron-builder": "^25.1.8",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "vite": "^5.4.10",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "@noble/hashes": "1.3.3"
  },
  "type": "module"
}
